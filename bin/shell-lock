#!/usr/bin/env python3
"""Run one command at a time under a local advisory file lock."""

import argparse
import errno
import math
import os
from pathlib import Path
import signal
import stat
import subprocess
import sys
import time

try:
    import fcntl
except ImportError:
    print("shell-lock requires a Unix platform with fcntl.flock", file=sys.stderr)
    sys.exit(2)

VERSION = "0.1.0"
BUSY = 75
STORAGE_ERROR = 73


def error(message):
    # Diagnostics are best effort. A closed/broken stderr must not change the exit
    # code or redirect diagnostics to stdout (sys.stderr can be None at startup).
    try:
        os.write(2, ("shell-lock: " + str(message) + "\n").encode("utf-8", "backslashreplace"))
    except OSError:
        pass


def same_file(path, fd):
    try:
        current = path.lstat()
    except OSError:
        return False
    opened = os.fstat(fd)
    return (stat.S_ISREG(current.st_mode) and opened.st_nlink == 1
            and (current.st_dev, current.st_ino) == (opened.st_dev, opened.st_ino))


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--version", action="version", version="shell-lock " + VERSION)
    parser.add_argument("--timeout", type=float, default=30,
                        help="Maximum seconds waiting for the lock; 0 tries once (default: 30).")
    parser.add_argument("lock_file", type=Path, help="Persistent lock-file path on a local filesystem.")
    parser.add_argument("command", nargs=argparse.REMAINDER, help="Command argv after --.")
    args = parser.parse_args(argv)
    if not math.isfinite(args.timeout) or args.timeout < 0:
        parser.error("--timeout must be a finite non-negative number")
    command = args.command
    if command and command[0] == "--":
        command = command[1:]
    if not command:
        parser.error("provide a command after the lock file and --")

    fd = None
    child = None
    received = None

    def forward(signum, _frame):
        nonlocal received
        if received is None:
            received = signum
        if child is not None:
            try:
                os.killpg(child.pid, signum)
            except ProcessLookupError:
                pass
            except OSError as exc:
                # A command may change credentials after exec. Losing permission
                # to signal it is not permission to stop waiting or release its lock.
                error("could not forward signal; waiting for command: " + str(exc))

    handlers = {}
    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        handlers[sig] = signal.signal(sig, forward)
    try:
        # Do not resolve the final component: O_NOFOLLOW must detect a symlink there.
        path = args.lock_file.absolute()
        path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        fd = os.open(path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK, 0o600)
        # An intentionally closed standard stream must remain closed in the command.
        # open() otherwise reuses fd 0/1/2, exposing the lock as stdin/stdout/stderr.
        if fd < 3:
            original_fd = fd
            fd = fcntl.fcntl(original_fd, fcntl.F_DUPFD_CLOEXEC, 3)
            os.close(original_fd)
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
            error("the lock path must be a regular file with one directory entry")
            return STORAGE_ERROR
        deadline = time.monotonic() + args.timeout
        while True:
            if received is not None:
                return 128 + received
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError as exc:
                if exc.errno not in (errno.EACCES, errno.EAGAIN):
                    raise
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    error("lock is busy: " + str(path))
                    return BUSY
                time.sleep(min(0.05, remaining))
        if not same_file(path, fd):
            error("lock path was replaced while waiting; command was not started")
            return STORAGE_ERROR
        if received is not None:
            return 128 + received
        env = dict(os.environ, SHELL_LOCK_FD=str(fd))
        try:
            # The command inherits the locked description. If this wrapper is killed,
            # its still-running child retains the lock unless it closes that descriptor.
            child = subprocess.Popen(command, env=env, pass_fds=(fd,), start_new_session=True)
        except FileNotFoundError:
            error("command not found: " + command[0])
            return 127
        except OSError as exc:
            if exc.errno in (errno.EACCES, errno.EPERM, errno.ENOEXEC, errno.EISDIR):
                error("command is not executable: " + command[0])
                return 126
            raise
        if received is not None:
            forward(received, None)
        result = child.wait()
        if received is not None:
            return 128 + received
        return result if result >= 0 else 128 - result
    except OSError as exc:
        error(exc)
        return STORAGE_ERROR
    finally:
        # Never unlink or explicitly unlock the file: inherited descriptors can still
        # protect a command or descendant after the wrapper exits.
        if fd is not None:
            os.close(fd)
        for sig, handler in handlers.items():
            signal.signal(sig, handler)


if __name__ == "__main__":
    sys.exit(main())
